local RARITY_GREEN = Color3.fromRGB(60, 220, 100)
local RARITY_PURPLE = Color3.fromRGB(170, 85, 255)
local RARITY_GOLD = Color3.fromRGB(255, 200, 40)
local function rarityColor(tool)
    local t = ""
    if tool then
        local r = tool:GetAttribute("Rarity") or tool:GetAttribute("rarity") or tool:GetAttribute("RarityTier")
        if type(r) == "string" then t = r end
    end
    if t == "" and tool then t = tool.Name end
    t = string.lower(t)
    if t:find("legend") or t:find("mythic") or t:find("mitic") or t:find("dorad") or t:find("gold") then
        return RARITY_GOLD
    end
    if t:find("epic") or t:find("rare") or t:find("raro") or t:find("purple") or t:find("morad") or t:find("violet") or t:find("elite") then
        return RARITY_PURPLE
    end
    return RARITY_GREEN
end
local function invUpdateEntry(b, displayName, char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tool = char:FindFirstChildOfClass("Tool")
    b.name.Visible = ESP.ShowName
    if ESP.ShowName then
        b.name.Text = displayName
    end
    b.weapon.Visible = ESP.ShowWeapon and tool ~= nil
    if tool then
        b.weapon.Text = tool.Name
        b.weapon.TextColor3 = rarityColor(tool)
    end
    b.health.Visible = ESP.ShowHealth and hum ~= nil
    if hum and ESP.ShowHealth then
        local maxHp = math.max(hum.MaxHealth, 1)
        local pct = math.clamp(hum.Health / maxHp, 0, 1)
        b.health.Text = string.format("HP %d/%d", math.floor(hum.Health + 0.5), math.floor(maxHp + 0.5))
        b.health.TextColor3 = Color3.fromRGB(255, 64, 64):Lerp(Color3.fromRGB(64, 255, 128), pct)
    end
end

local function invUpdate()
    if not ESP.Enabled then
        invDestroyAll()
        return
    end
    local seen = {}
    if ESP.Players then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character and plr.Character.Parent then
                seen[plr.Character] = true
                local b = invEnsure(plr.Character)
                if b then
                    b.gui.MaxDistance = ESP.MaxDistance
                    invUpdateEntry(b, plr.Name, plr.Character)
                end
            end
        end
    end
    if ESP.AI then
        for _, model in ipairs(aiCharacters()) do
            if model and model.Parent then
                seen[model] = true
                local b = invEnsure(model)
                if b then
                    b.gui.MaxDistance = ESP.MaxDistance
                    invUpdateEntry(b, model.Name, model)
                end
            end
        end
    end
    for model in pairs(invBillboards) do
        if not seen[model] then
            invDestroy(model)
        end
    end
end

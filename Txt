local loopTokens = {}
local function startLoop(key, interval, fn)
    if loopTokens[key] then return end
    local token = {}
    loopTokens[key] = token
    task.spawn(function()
        while loopTokens[key] == token do
            pcall(fn)
            task.wait(interval)
        end
    end)
end
local function stopLoop(key)
    loopTokens[key] = nil
end

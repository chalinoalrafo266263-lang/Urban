    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local fire = remotes and remotes:FindFirstChild("Fire")
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        if silentAim and (not silentRMB or silentRMBHeld) and (self == fire or self == currentCam) then
            local method = getnamecallmethod()
            if method == "ViewportPointToRay" then
                local pos = silentAimTarget()
                if pos then
                    local cam = currentCam
                    local o = cam.CFrame.Position
                    local d = pos - o
                    if d.Magnitude > 0.1 then return Ray.new(o, d.Unit) end
                end
            elseif fire and method == "FireServer" and self == fire then
                local args = table.pack(...)
                local pos, origin = silentAimTarget()
                if pos and origin and args.n == 13 then
                    local d = pos - origin
                    if d.Magnitude > 0.1 then
                        d = d.Unit
                        args[1] = origin
                        args[2] = d
                        args[11] = origin
                        args[12] = d
                        args[13] = pos
                        spawnTracer(origin, pos)
                        return old(self, table.unpack(args, 1, 13))
                    end
                end
            end
        end
        return old(self, ...)
    end)
end

RunService.RenderStepped:Connect(function()
    local cam = Workspace.CurrentCamera
    local radius
    if silentCircleEnabled and cam then
        local vpY = cam.ViewportSize.Y
        if vpY > 0 then
            local focal = (vpY / 2) / math.tan(math.rad(cam.FieldOfView) / 2)
            radius = math.tan(math.rad(math.min(silentFov, 89))) * focal
        end
    end
    if not radius then
        if fovCircleGui then destroyFovCircle() end
    else
        local circle = ensureFovCircle()
        if circle then
            local vp = cam.ViewportSize
            if vp.Y > 0 then
                local diameter = math.max(radius * 2, 2)
                circle.Size = UDim2.fromOffset(diameter, diameter)
                circle.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
            end
        end
    end
    local line
    if silentAim and (not silentRMB or silentRMBHeld) and cam then
        local pos = silentAimTarget()
        if pos then
            local sp, onScreen = cam:WorldToViewportPoint(pos)
            if onScreen and sp.Z > 0 then
                local vp = cam.ViewportSize
                local sx, sy = vp.X * 0.5, vp.Y * 0.5
                local dx, dy = sp.X - sx, sp.Y - sy
                local length = math.sqrt(dx * dx + dy * dy)
                if length > 4 then
                    line = ensureTargetLine()
                    if line then
                        line.Visible = true
                        line.Position = UDim2.fromOffset((sx + sp.X) * 0.5, (sy + sp.Y) * 0.5)
                        line.Size = UDim2.fromOffset(length, 1.5)
                        line.Rotation = math.deg(math.atan2(dy, dx))
                    end
                end
            end
        end
    end
    if not line and targetLineFrame then
        targetLineFrame.Visible = false
    end
end)

